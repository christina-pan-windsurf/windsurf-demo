[run]
source = .
omit = 
    tests/*
    venv/*
    env/*
    .venv/*
    __pycache__/*
    .git/*
    setup.py
    */migrations/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
