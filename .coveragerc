[run]
source = .
omit = 
    tests/*
    venv/*
    env/*
    */venv/*
    */env/*
    __pycache__/*
    */__pycache__/*
    node_modules/*
    static/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod
